{
	"name": "@thasmo/erna-ole-website",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"deploy": "void deploy --platform cloudflare",
		"upload": "wrangler versions upload --config dist/client/wrangler.json",
		"prepare": "concurrently --group --prefix-colors 'auto' 'pnpm:prepare:*'",
		"prepare:hooks": "vp config --no-agent",
		"prepare:astro": "astro sync",
		"lint": "concurrently --group --prefix-colors 'auto' 'pnpm:lint:*'",
		"lint:eslint": "eslint .",
		"lint:cspell": "cspell --no-progress --no-summary --no-must-find-files .",
		"lint:knip": "knip --no-progress",
		"fix": "concurrently --group --prefix-colors 'auto' 'pnpm:fix:*'",
		"fix:eslint": "eslint --fix .",
		"fix:knip": "knip --fix --no-progress --workspace ."
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.4.2",
		"@astrojs/sitemap": "^3.2.1",
		"astro": "^7.0.0",
		"motion": "^14.0.0",
		"tone": "^15.1.22"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.0",
		"@somehow-digital/commitlint-config": "^1.0.0",
		"@somehow-digital/cspell-dictionary": "^2.0.0",
		"@somehow-digital/eslint-config": "^5.0.0",
		"@somehow-digital/typescript-config": "^3.0.0",
		"@somehow-digital/unocss-preset": "^2.0.0",
		"@types/node": "^26.0.0",
		"@unocss/astro": "^66.6.6",
		"@unocss/preset-web-fonts": "^66.3.3",
		"concurrently": "^10.0.0",
		"cspell": "^10.0.0",
		"eslint": "^10.0.0",
		"knip": "^6.0.0",
		"typescript": "^6.0.0",
		"unocss": "^66.5.12",
		"vite-plus": "1.4.0",
		"void": "^1.4.0",
		"wrangler": "^4.155.0"
	}
}

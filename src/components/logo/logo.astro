<video
	data-logo-video
	src="/motion.mp4"
	preload="auto"
	autoplay
	loop
	muted
	playsinline
	aria-hidden="true"
	class="opacity-0 h-full w-full pointer-events-none inset-0 pos-fixed object-cover"
></video>

<canvas data-logo-canvas aria-hidden="true" class="h-full w-full pointer-events-none inset-0 pos-fixed"></canvas>

<h1 data-logo-container class="leading-none font-700 opacity-0 flex flex-col pointer-events-none select-none uppercase pos-relative lg:inline-flex lg:flex-row lg:gap-8" style="font-size: clamp(4rem, 15vw, 10rem);">
	<span class="opacity-0 block lg:inline-block">Erna</span>
	<span class="opacity-0 block lg:inline-block">×</span>
	<span class="opacity-0 block lg:inline-block">Ole</span>
</h1>

<script>
import { animate } from 'motion';
import type { Border, Glyph } from './stencil';
import { EASE, startLogo } from './animation';
import { createLogoSound } from './sound';
import { createStencil } from './stencil';

const INTRO_OPTIONS = { delay: 0.25, duration: 2.5, ease: EASE };
const SPAWN_TEXTS = [...'ERNA×OLE'];

const container = document.querySelector<HTMLElement>('[data-logo-container]');
const video = document.querySelector<HTMLVideoElement>('[data-logo-video]');
const canvas = document.querySelector<HTMLCanvasElement>('[data-logo-canvas]');

if (container && video && canvas) {
	const parts = [...container.children] as HTMLElement[];
	const [erna, x, ole] = parts as [HTMLElement, HTMLElement, HTMLElement];
	const { backgroundColor } = window.getComputedStyle(document.documentElement);
	const stencil = createStencil(canvas, backgroundColor === 'rgba(0, 0, 0, 0)' ? '#fff' : backgroundColor);

	const letters: Glyph[] = [];
	let logo: Glyph[] = [];
	let border: Border | undefined;
	let fontSize = 0;
	let fontFamily = '';
	let syncing = true;

	// Mirrors the invisible HTML logo (and the body border it covers) onto the stencil.
	function measure() {
		const styles = window.getComputedStyle(container!);
		fontSize = Number.parseFloat(styles.fontSize);
		fontFamily = styles.fontFamily;
		const font = `700 ${fontSize}px ${fontFamily}`;

		logo = parts.map((part) => {
			const rect = part.getBoundingClientRect();
			const partStyles = window.getComputedStyle(part);
			const cx = rect.left + rect.width / 2;
			const cy = rect.top + rect.height / 2;

			return {
				text: part.textContent!.toUpperCase(),
				font,
				x: cx,
				y: rect.top + rect.height * 0.8,
				opacity: Number(partStyles.opacity),
				transform: partStyles.transform === 'none'
					? undefined
					: new DOMMatrix().translate(cx, cy).multiply(new DOMMatrix(partStyles.transform)).translate(-cx, -cy),
			};
		});

		const bodyStyles = window.getComputedStyle(document.body);
		const borderWidth = Number.parseFloat(bodyStyles.borderTopWidth);
		border = borderWidth > 0
			? { rect: document.body.getBoundingClientRect(), width: borderWidth, color: bodyStyles.borderTopColor }
			: undefined;
	}

	function paint() {
		stencil.paint([...logo, ...letters], border);
	}

	// Follows the intro animations frame by frame; afterwards the logo is static.
	function sync() {
		measure();
		paint();
		if (syncing)
			requestAnimationFrame(sync);
	}

	stencil.resize();
	sync();
	video.style.opacity = '1';

	window.addEventListener('resize', () => {
		stencil.resize();
		measure();
		paint();
	});

	function intro(element: HTMLElement, transform: [string, string]) {
		return animate(element, { opacity: [0, 1], transform }, INTRO_OPTIONS).finished;
	}

	const videoReady = video.readyState >= 3
		? Promise.resolve()
		: new Promise<void>(resolve => video.addEventListener('canplay', () => resolve(), { once: true }));
	const fontsReady = document.fonts?.ready ?? Promise.resolve();

	Promise.all([videoReady, fontsReady]).then(() => {
		startLogo();

		const axis = window.matchMedia('(max-width: 1023px)').matches ? 'Y' : 'X';
		const slide = (offset: string): [string, string] => [
			`translate${axis}(${offset}) scale${axis}(0.95)`,
			`translate${axis}(0) scale${axis}(1)`,
		];

		Promise.all([
			intro(erna, slide('0.25em')),
			intro(x, ['scale(0.75)', 'scale(1)']),
			intro(ole, slide('-0.25em')),
		]).then(() => {
			syncing = false;
		});

		setTimeout(enableClickSpawn, 1000);
	});

	function enableClickSpawn() {
		const sound = createLogoSound();
		let last: { x: number; y: number } | undefined;

		function spawnLetter(px: number, py: number) {
			const font = `700 ${fontSize * 0.5}px ${fontFamily}`;
			// Centers the letter on the pointer like SVG `dominant-baseline: middle`.
			const y = py + stencil.xHeight(font) / 2;
			letters.push({ text: SPAWN_TEXTS[letters.length % SPAWN_TEXTS.length]!, font, x: px, y, opacity: 1 });
			last = { x: px, y: py };
			paint();
			sound.playNote(px, py);
		}

		document.documentElement.style.setProperty('--cursor', 'crosshair');
		document.documentElement.style.touchAction = 'none';

		document.addEventListener('pointerdown', (e) => {
			if (e.isPrimary)
				spawnLetter(e.clientX, e.clientY);
		});
		document.addEventListener('pointermove', (e) => {
			if (e.isPrimary && last && Math.hypot(e.clientX - last.x, e.clientY - last.y) >= fontSize * 0.65)
				spawnLetter(e.clientX, e.clientY);
		});
		for (const type of ['pointerup', 'pointercancel']) {
			document.addEventListener(type, () => {
				last = undefined;
			});
		}

		document.addEventListener('keydown', (e) => {
			if (e.key !== 'Escape')
				return;
			letters.length = 0;
			sound.reset();
			paint();
		});
	}
}
</script>
